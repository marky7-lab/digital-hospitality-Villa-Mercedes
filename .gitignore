# Impeccable design hook: the shared config (which files are scanned) is committed,
# everything machine-local is not. The hook manifest embeds this machine's home
# directory; config.local.json holds this developer's consent decision.
/.cursor/hooks.json
/.impeccable/config.local.json
/.impeccable/hook.cache.json

# Local Cloudflare Tunnel demonstration runtime and credentials.
/.preview/
/.full-tunnel/
.env.preview
.env.tunnel*

# Local caches, test artifacts, and generated report exports.
/storage/node-compile-cache/
/storage/framework/node-compile-cache/
/storage/framework/mwg-guide-*.md
/tmp/
/tmp-*.log
/output/pdf/

# UI UX Pro Max design skill (npm package ui-ux-pro-max-cli). Vendored and
# regenerated by the installer, so it is ignored the way /vendor and
# /node_modules are: the install procedure lives in docs/RULES.md, not in the
# tracked tree. Running its Python scripts also drops __pycache__ next to them.
/.cursor/skills/
/.agents/skills/
__pycache__/

# The skill's per-project design system, generated by `--persist` and rewritten
# wholesale on regeneration. It is advisory and its palette is not ours, so the
# tracked artifact is the reconciliation in docs/DESIGN-SYSTEM.md, not the output.
/design-system/
